{
  "name": "agent-studio",
  "version": "0.6",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mentrauz/Agent-HUB"
  },
  "homepage": "https://agenthub-seven-rouge.vercel.app/",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run --exclude tests/performance/**",
    "test:unit": "vitest run tests/unit/**",
    "test:integration": "vitest run tests/integration/**",
    "test:performance": "PERF_BASE_URL=http://localhost:3000 vitest run tests/performance/**",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@hookform/resolvers": "3.10.0",
    "@langchain/langgraph": "^1.5.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "js-yaml": "^5.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "0.474.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
