{
  "name": "agent-studio",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Mentrauz/Agent-HUB"
  },
  "homepage": "https://agenthub-seven-rouge.vercel.app/",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run --exclude tests/performance/**",
    "test:unit": "vitest run tests/unit/**",
    "test:integration": "vitest run tests/integration/**",
    "test:performance": "PERF_BASE_URL=http://localhost:3000 vitest run tests/performance/**",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@hookform/resolvers": "3.10.0",
    "@langchain/langgraph": "^1.4.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "js-yaml": "^5.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.474.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}